# Example only. Never commit a real .env file or share an operating database.
DB_PATH=./data.db
# Rendered email copies contain customer data; keep this directory private.
EMAIL_OUTPUT_DIR=./emails
PORT=5000
# Network address to listen on. Default 127.0.0.1 (this machine only). Put a TLS reverse
# proxy in front for remote access; use 0.0.0.0 only on a private network or in a container.
HOST=127.0.0.1
# Reverse proxies in front of the app (hop count such as 1, or "loopback"). Leave empty
# when there is no proxy. Needed for correct client addresses in rate limits and HTTPS detection.
TRUST_PROXY=
# Days to keep temporary copies of emails addressed only to the internal test mailbox
# (emails/test-copies/). Empty means 30; 0 keeps them. Copies of anything sent to a customer
# (emails/sent-records/) and files saved before this setting existed are never deleted.
EMAIL_TEST_COPY_RETENTION_DAYS=
# 64 hex characters from `node handoff/database.mjs keygen`. Encrypts backups. Keep it in a
# password manager or secret store, never in this file on a shared machine or next to backups.
BACKUP_ENCRYPTION_KEY=
NODE_ENV=production
# Leave credentials empty for development. No email delivery will occur.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
